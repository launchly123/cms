# Copy to .env.local for local dev, and set these in Vercel → Project → Settings
# → Environment Variables for the deployed CMS. Never commit real values.

# Clerk (owner dashboard auth) — clerk.com/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (content + image storage) — supabase.com/dashboard → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel API token (auto-import client sites) — vercel.com/account/tokens
VERCEL_API_TOKEN=

# GitHub token (optional, future git publishing) — github.com/settings/tokens
GITHUB_TOKEN=

# Shared secret used to push content live to client sites (any random string)
REVALIDATE_SECRET=

# Secret for signing client-editor session cookies (any long random string)
CLIENT_SESSION_SECRET=
